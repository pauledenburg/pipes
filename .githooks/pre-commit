#!/bin/bash

# Pre-commit hook for Pipes ETL Library
# This hook runs quality checks before allowing a commit

echo "Running pre-commit quality checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to check if a command succeeded
check_result() {
    if [ $? -ne 0 ]; then
        echo -e "${RED}✗ $1 failed${NC}"
        exit 1
    else
        echo -e "${GREEN}✓ $1 passed${NC}"
    fi
}

# 1. Check for PHP syntax errors in staged files
echo -e "${YELLOW}Checking PHP syntax...${NC}"
for file in $(git diff --cached --name-only --diff-filter=ACM | grep '\.php$'); do
    php -l "$file" > /dev/null 2>&1
    if [ $? -ne 0 ]; then
        echo -e "${RED}✗ PHP syntax error in $file${NC}"
        exit 1
    fi
done
echo -e "${GREEN}✓ PHP syntax check passed${NC}"

# 2. Run PHPStan on changed files
echo -e "${YELLOW}Running PHPStan...${NC}"
if [ -f "vendor/bin/phpstan" ]; then
    vendor/bin/phpstan analyse --memory-limit=2G --no-progress
    check_result "PHPStan analysis"
else
    echo -e "${YELLOW}⚠ PHPStan not installed, skipping...${NC}"
fi

# 3. Run tests
echo -e "${YELLOW}Running tests...${NC}"
if [ -f "vendor/bin/phpunit" ]; then
    vendor/bin/phpunit --stop-on-failure --no-coverage
    check_result "PHPUnit tests"
else
    echo -e "${YELLOW}⚠ PHPUnit not installed, skipping...${NC}"
fi

# 4. Check code style (only on staged PHP files)
echo -e "${YELLOW}Checking code style...${NC}"
if [ -f "vendor/bin/php-cs-fixer" ]; then
    # Get list of staged PHP files
    STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.php$')
    
    if [ -n "$STAGED_FILES" ]; then
        # Check if any files need fixing
        vendor/bin/php-cs-fixer fix --dry-run --diff --verbose $STAGED_FILES > /dev/null 2>&1
        
        if [ $? -ne 0 ]; then
            echo -e "${YELLOW}⚠ Code style issues found. Fixing automatically...${NC}"
            
            # Fix the files
            vendor/bin/php-cs-fixer fix $STAGED_FILES
            
            # Re-stage the fixed files
            for file in $STAGED_FILES; do
                git add "$file"
            done
            
            echo -e "${GREEN}✓ Code style fixed and files re-staged${NC}"
        else
            echo -e "${GREEN}✓ Code style check passed${NC}"
        fi
    fi
else
    echo -e "${YELLOW}⚠ PHP-CS-Fixer not installed, skipping...${NC}"
fi

# 5. Check for debug statements
echo -e "${YELLOW}Checking for debug statements...${NC}"
FORBIDDEN_PATTERNS=(
    "var_dump"
    "print_r"
    "dd("
    "dump("
    "ray("
    "console.log"
    "debugger"
)

for pattern in "${FORBIDDEN_PATTERNS[@]}"; do
    if git diff --cached --name-only --diff-filter=ACM | xargs grep -l "$pattern" 2>/dev/null; then
        echo -e "${RED}✗ Found forbidden debug statement: $pattern${NC}"
        echo "Please remove all debug statements before committing."
        exit 1
    fi
done
echo -e "${GREEN}✓ No debug statements found${NC}"

echo -e "${GREEN}All pre-commit checks passed!${NC}"
exit 0