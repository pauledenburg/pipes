includes:
    - ./vendor/larastan/larastan/extension.neon

parameters:

    paths:
        - src/

    # Level 9 is the highest level
    level: 9

    ignoreErrors:
        # Carbon::createFromFormat() false comparison - varies by dependency versions
        -
            message: '#Strict comparison using === between .* and false will always evaluate to false#'
            path: src/Transformers/DateTimeTransformer.php
            reportUnmatched: false
        # DOMNamedNodeMap null check - varies by PHP/DOM versions
        -
            message: '#Strict comparison using !== between DOMNamedNodeMap and null will always evaluate to true#'
            path: src/Extractors/StreamingXmlExtractor.php
            reportUnmatched: false

#
#    excludePaths:
#        - ./*/*/FileToBeExcluded.php
#
#    checkMissingIterableValueType: false

