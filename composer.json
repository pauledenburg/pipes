{
    "name": "jwhulette/pipes",
    "description": "An PHP ETL Processing Library",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Wes Hulette",
            "email": "jwhulette@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "league/pipeline": "^1.0",
        "openspout/openspout": "^4.13.1",
        "illuminate/support" : "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/database" : "^8.0|^9.0|^10.0|^11.0|^12.0",
        "nesbot/carbon": "^2.67|^3.10"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^v3.13.0",
        "phpunit/phpunit": "^12.2",
        "phpstan/phpstan": "^2.1",
        "ramsey/uuid": "^4.7.3",
        "orchestra/testbench": "^10.4",
        "larastan/larastan": "^3.5",
        "nunomaduro/phpinsights": "^2.13"
    },
    "autoload": {
        "psr-4": {
            "Jwhulette\\Pipes\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "tf" : "./vendor/bin/phpunit --filter ",
        "phpstan": "phpstan analyse --memory-limit 2G",
        "ts": [
            "composer phpstan",
            "composer test"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jwhulette\\Pipes\\PipesPackageServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}